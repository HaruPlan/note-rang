      "template.settings.templates.hints.weekday": "Weekday",
      "template.settings.templates.hints.week": "ISO week",
      "template.settings.templates.hints.title": "Note title (filename)",
      "template.settings.templates.hints.path": "Note path",
      "template.settings.templates.hints.uuid": "Random UUID",
      "template.settings.templates.hints.cursor": "Where the cursor lands after insert",
      "template.settings.insertMode.label": "Insert mode",
      "template.settings.insertMode.options.cursor": "Cursor position",
      "template.settings.insertMode.options.append": "Append to end of document",
      "template.settings.insertMode.options.replace": "Replace entire document",
      "template.settings.dateFormat.label": "Date format"
    }
  }
}
