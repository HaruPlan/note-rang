    "en": {
      "template.name": "Templates",
      "template.summary": "Toolbar buttons for inserting frequently used document starters",
      "template.settingsDescription": "Inserts a pre-made document at the cursor, expanding keywords as it goes. Keep several templates and pick one to insert from the 📑 button on the note toolbar.",
