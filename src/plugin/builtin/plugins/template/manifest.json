{
  "id": "template",
  "name": "%template.name%",
  "version": "1.0.0",
  "summary": "%template.summary%",
  "kind": "action",
  "entry": "main.js",
  "permissions": ["ui", "settings", "notes:read", "notes:write"],
  "settingsCategory": "도구",
  "settingsDescription": "%template.settingsDescription%",
  "settings": [
    {
      "key": "templates",
      "label": "%template.settings.templates.label%",
      "type": "list",
      "itemLabel": "%template.settings.templates.itemLabel%",
      "itemNamePlaceholder": "%template.settings.templates.itemNamePlaceholder%",
      "itemBodyPlaceholder": "%template.settings.templates.itemBodyPlaceholder%",
      "description": "%template.settings.templates.description%",
      "default": "=== 📅 주간회의 ===\n# {week}주차 주간회의 ({today} {weekday})\n\n## 지난주 리뷰\n- {cursor}\n\n## 이번주 계획\n-\n\n## 논의사항\n-\n\n=== 📝 데일리 ===\n## {today} 데일리 노트\n- 오늘 할 일:\n\n=== ✅ 회고 ===\n# 회고 ({today})\n- Keep:\n- Problem:\n- Try:",
      "options": [],
      "hints": [
        {
          "token": "{today}",
          "label": "%template.settings.templates.hints.today%"
        },
        {
          "token": "{yesterday}",
          "label": "%template.settings.templates.hints.yesterday%"
        },
        {
          "token": "{tomorrow}",
          "label": "%template.settings.templates.hints.tomorrow%"
        },
        {
          "token": "{today+7}",
          "label": "%template.settings.templates.hints.today-offset%"
        },
        {
          "token": "{monday}",
          "label": "%template.settings.templates.hints.monday%"
        },
        {
          "token": "{sunday}",
          "label": "%template.settings.templates.hints.sunday%"
        },
        {
          "token": "{time}",
          "label": "%template.settings.templates.hints.time%"
        },
        {
          "token": "{datetime}",
          "label": "%template.settings.templates.hints.datetime%"
        },
        {
          "token": "{now}",
          "label": "%template.settings.templates.hints.now%"
        },
        {
          "token": "{year}",
          "label": "%template.settings.templates.hints.year%"
        },
        {
          "token": "{month}",
          "label": "%template.settings.templates.hints.month%"
        },
        {
          "token": "{day}",
          "label": "%template.settings.templates.hints.day%"
        },
        {
          "token": "{weekday}",
          "label": "%template.settings.templates.hints.weekday%"
        },
        {
          "token": "{week}",
          "label": "%template.settings.templates.hints.week%"
        },
        {
          "token": "{title}",
          "label": "%template.settings.templates.hints.title%"
        },
        {
          "token": "{path}",
          "label": "%template.settings.templates.hints.path%"
        },
        {
          "token": "{uuid}",
          "label": "%template.settings.templates.hints.uuid%"
        },
        {
          "token": "{cursor}",
          "label": "%template.settings.templates.hints.cursor%"
        }
      ]
    },
    {
      "key": "insertMode",
      "label": "%template.settings.insertMode.label%",
      "type": "select",
      "default": "cursor",
      "options": [
        {
          "value": "cursor",
          "label": "%template.settings.insertMode.options.cursor%"
        },
        {
          "value": "append",
          "label": "%template.settings.insertMode.options.append%"
        },
        {
          "value": "replace",
          "label": "%template.settings.insertMode.options.replace%"
        }
      ]
    },
    {
      "key": "dateFormat",
      "label": "%template.settings.dateFormat.label%",
      "type": "select",
      "default": "iso",
      "options": [
        { "value": "iso", "label": "2026-07-09" },
        { "value": "dot", "label": "2026.07.09" },
        { "value": "ko", "label": "2026년 7월 9일" }
      ]
    }
  ],
  "nls": {
    "default": {
      "template.name": "템플릿",
      "template.summary": "자주 쓰는 문서 초기값을 툴바 버튼으로",
      "template.settingsDescription": "미리 만든 문서를 키워드 치환과 함께 커서 위치에 끼워 넣어요. 템플릿을 여러 개 만들어 두고, 메모 툴바의 📑 버튼으로 골라 삽입합니다.",
      "template.settings.templates.label": "템플릿",
