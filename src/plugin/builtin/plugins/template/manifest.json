      "template.settings.templates.itemLabel": "Template",
      "template.settings.templates.itemNamePlaceholder": "e.g. Weekly meeting",
      "template.settings.templates.itemBodyPlaceholder": "Enter the body. Keywords like {today} are replaced with real values when inserted.",
