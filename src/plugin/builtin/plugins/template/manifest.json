      "template.settings.templates.hints.sunday": "This week's Sunday",
      "template.settings.templates.hints.time": "Current time HH:MM",
      "template.settings.templates.hints.datetime": "Date + time",
      "template.settings.templates.hints.now": "Date + time:seconds",
      "template.settings.templates.hints.year": "Year",
