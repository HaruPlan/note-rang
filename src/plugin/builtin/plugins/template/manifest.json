      "template.settings.templates.hints.monday": "이번주 월요일",
      "template.settings.templates.hints.sunday": "이번주 일요일",
      "template.settings.templates.hints.time": "현재 시각 HH:MM",
      "template.settings.templates.hints.datetime": "날짜 + 시각",
      "template.settings.templates.hints.now": "날짜 + 시:분:초",
      "template.settings.templates.hints.year": "연",
      "template.settings.templates.hints.month": "월",
      "template.settings.templates.hints.day": "일",
      "template.settings.templates.hints.weekday": "요일",
      "template.settings.templates.hints.week": "ISO 주차",
      "template.settings.templates.hints.title": "메모 제목(파일명)",
      "template.settings.templates.hints.path": "메모 경로",
      "template.settings.templates.hints.uuid": "임의 UUID",
      "template.settings.templates.hints.cursor": "삽입 후 커서가 놓일 자리",
      "template.settings.insertMode.label": "삽입 방식",
